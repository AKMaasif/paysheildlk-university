# Copy to .env for local overrides. Docker Compose reads this file for interpolation.
# Leave keys empty to run the whole demo on the deterministic mock engine.

# The main model: Meta. OpenAI-compatible. Muse models spend tokens on reasoning, so the client
# asks for a large max_tokens budget. Models on the key used for testing include muse-ember-1.0 and
# muse-spark-1.1 to 1.3 (text); muse-image, muse-voice-transcribe and sam are not text models.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-ember-1.0

# The fallback model: Grok (xAI), tried only when Meta fails. OpenAI-compatible chat completions.
# A non-reasoning model suits short notes: it answers fast and spends no tokens thinking first.
# Other models on the key used for testing: grok-4.20-0309-reasoning, grok-4.3, grok-4.5, grok-4.6, grok-4.7.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.20-0309-non-reasoning

# Firebase Cloud Messaging (HTTP v1). All three are required for real push.
# The customer app still updates over WebSocket when these are empty.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional web config if you wire the Firebase JS SDK later.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Which direct callers may tell the backend a visitor's address through X-Forwarded-For (addresses or CIDR ranges,
# comma separated). The web server's proxy must be listed, nothing else should be.
TRUSTED_PROXIES=127.0.0.1,::1

# Demonstration mode: deterministic (default, nothing leaves the machine), hybrid (real SMS/email to the listed test
# recipients only), external (also reads the operator gateway named by TELCO_BASE_URL), or production.
# In hybrid and external an empty allow-list sends to nobody. Credentials come only from here, never from source.
DEMO_MODE=deterministic
DEMO_ALLOWED_PHONES=
DEMO_ALLOWED_EMAILS=
NOTIFY_MAX_PER_HOUR=20
NOTIFY_MAX_ATTEMPTS=2

# Text.lk SMS. Empty means the log driver. Messages never include a link or a code.
TEXTLK_API_KEY=
TEXTLK_API_URL=https://app.text.lk/api/v3/sms/send
SMS_SENDER_ID=PayShield

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@payshield.lk

# Point this at a real CAMARA SIM Swap gateway later. Empty uses the local mock.
TELCO_BASE_URL=
TELCO_TOKEN=

# development or production. With APP_ENV=production the backend refuses to start
# unless the four secrets below are set to random values of 32+ characters
# (for example: openssl rand -hex 32) and DEMO_ASSIST is false.
APP_ENV=development
# The sites allowed to call the API from a browser, comma separated. Leave empty for the local development addresses.
# In production this must be the real https:// address of the site, never *.
# Session cookies carry the Secure flag by default when APP_ENV=production. Leave this unset unless you test over plain http.
# COOKIE_SECURE=true
ALLOWED_ORIGINS=
JWT_SECRET=dev-only-change-me-payshield-pilot
# At least 32 characters; make one with `openssl rand -hex 32`. Changing it later makes stored data unreadable.
ENCRYPTION_KEY=dev-only-payshield-encryption-key
HMAC_KEY=dev-only-payshield-hmac-key
ANSWER_PEPPER=payshield-pilot-pepper
DEMO_ASSIST=true
REALERT_SECONDS=180
ESCALATE_SECONDS=600
STEP_DELAY_MS=400

# Used by Compose. Override only if you are not using the bundled Postgres.
DATABASE_URL=postgresql+psycopg://payshield:payshield@postgres:5432/payshield
REDIS_URL=redis://redis:6379/0

# Agentic features. Both are optional.
# Learn what is usual for each customer from their own ledger and use it in the risk score.
CUSTOMER_PROFILE=true
# Route the Telecom and Banking read-only lookups through the Model Context Protocol.
MCP_TOOLS=false

# Face verification. dlib is the real face matcher. legacy is a two-frame demo check with no recognition.
FACE_ENGINE=dlib
# Turn off only for demos with a still-photo camera feed. Off means a held-up photo can pass the liveness check.
FACE_CHALLENGE=true
