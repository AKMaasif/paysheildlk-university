# Copy to .env for local overrides. Docker Compose reads this file for interpolation.
# Leave keys empty to run the whole demo on the deterministic mock engine.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible. Muse models spend tokens on reasoning, so the client
# asks for a large max_tokens budget.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-ember-1.0

# Firebase Cloud Messaging (HTTP v1). All three are required for real push.
# The customer app still updates over WebSocket when these are empty.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional web config if you wire the Firebase JS SDK later.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Text.lk SMS. Empty means the log driver. Messages never include a link or a code.
TEXTLK_API_KEY=
TEXTLK_API_URL=https://app.text.lk/api/v3/sms/send
SMS_SENDER_ID=PayShield

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@payshield.lk

# Point this at a real CAMARA SIM Swap gateway later. Empty uses the local mock.
TELCO_BASE_URL=
TELCO_TOKEN=

# development or production. With APP_ENV=production the backend refuses to start
# unless the four secrets below are set to random values of 32+ characters
# (for example: openssl rand -hex 32) and DEMO_ASSIST is false.
APP_ENV=development
JWT_SECRET=dev-only-change-me-payshield-pilot
ENCRYPTION_KEY=dev-only-payshield-encryption-key
HMAC_KEY=dev-only-payshield-hmac-key
ANSWER_PEPPER=payshield-pilot-pepper
DEMO_ASSIST=true
REALERT_SECONDS=180
ESCALATE_SECONDS=600
STEP_DELAY_MS=400

# Used by Compose. Override only if you are not using the bundled Postgres.
DATABASE_URL=postgresql+psycopg://payshield:payshield@postgres:5432/payshield
REDIS_URL=redis://redis:6379/0

# Agentic features. Both are optional.
# Learn what is usual for each customer from their own ledger and use it in the risk score.
CUSTOMER_PROFILE=true
# Route the Telecom and Banking read-only lookups through the Model Context Protocol.
MCP_TOOLS=false

# Face verification. dlib is the real face matcher. legacy is a two-frame demo check with no recognition.
FACE_ENGINE=dlib
# Turn off only for demos with a still-photo camera feed. Off means a held-up photo can pass the liveness check.
FACE_CHALLENGE=true
